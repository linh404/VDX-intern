<odoo>
    <record id="estate_property_rule_user" model="ir.rule">
        <field name="name">Internal User: all estate properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="estate_property_rule_manager" model="ir.rule">
        <field name="name">Settings User: all estate properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="estate_property_offer_rule_user" model="ir.rule">
        <field name="name">Internal User: own estate property offers</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="estate_property_offer_rule_manager" model="ir.rule">
        <field name="name">Settings User: all estate property offers</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
