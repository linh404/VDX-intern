<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="estate_property_list" name="Estate Property List">
        <t t-call="website.layout">
            <div id="wrap" class="container my-4">
                <h1>Estate Properties</h1>

                <p t-if="not properties">No properties are available.</p>

                <table t-if="properties" class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Property</th>
                            <th class="text-end">Report</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="properties" t-as="p">
                            <td t-out="p.name"/>
                            <td class="text-end">
                                <form t-attf-action="/estate/property/#{p.id}/report" method="get">
                                    <button type="submit" class="btn btn-primary btn-sm">Report</button>
                                </form>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>
