<odoo>
    <record id="estate_property_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">estate.property.cancel.wizard.form</field>
        <field name="model">estate.property.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Property">
                <group>
                    <field name="property_id" readonly="1"/>
                    <field name="reason" placeholder="Reason for cancellation"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
