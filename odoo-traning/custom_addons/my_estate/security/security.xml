<odoo>
    <record id="res_groups_privilege_estate" model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_estate_user" model="res.groups">
        <field name="name">Estate User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_estate_manager" model="res.groups">
        <field name="name">Estate Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="implied_ids" eval="[Command.link(ref('my_estate.group_estate_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="estate_property_rule_user" model="ir.rule">
        <field name="name">Estate User: own or unassigned properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('my_estate.group_estate_user'))]"/>
        <field name="domain_force">['|', ('salesperson_id', '=', user.id), ('salesperson_id', '=', False)]</field>
    </record>

    <record id="estate_property_rule_manager" model="ir.rule">
        <field name="name">Estate Manager: all estate properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('my_estate.group_estate_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="estate_property_offer_rule_user" model="ir.rule">
        <field name="name">Estate User: offers on own or unassigned properties</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[Command.link(ref('my_estate.group_estate_user'))]"/>
        <field name="domain_force">['|', ('property_id.salesperson_id', '=', user.id), ('property_id.salesperson_id', '=', False)]</field>
    </record>

    <record id="estate_property_offer_rule_manager" model="ir.rule">
        <field name="name">Estate Manager: all estate property offers</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[Command.link(ref('my_estate.group_estate_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
