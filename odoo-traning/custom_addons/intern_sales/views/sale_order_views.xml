<odoo>
    <record id="view_order_form_inherit_discount_approval" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.discount.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_approve_discount"
                        type="object"
                        string="Approve Discount"
                        class="btn-primary"
                        groups="intern_sales.group_discount_approver"
                        invisible="state != 'to_approve'"/>
            </xpath>

            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,to_approve,sale</attribute>
            </xpath>

            <xpath expr="//group[@name='sale_header']" position="after">
                <group name="discount_approval" string="Discount Approval">
                    <group>
                        <field name="requires_approval" readonly="1"/>
                        <field name="discount_approved" readonly="1"/>
                    </group>
                    <group>
                        <field name="discount_approved_by" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_inherit_discount_approval" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.discount.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="requires_approval" optional="show"/>
                <field name="discount_approved" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
